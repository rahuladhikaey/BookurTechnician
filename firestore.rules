rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' || 
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.admin == true
      );
    }

    // Public & Live Operational Collections for Spark Mode
    match /service_categories/{categoryId} {
      allow read, write: if true;
    }

    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // Users & Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    match /customers/{custId} {
      allow read, write: if true;
    }

    match /technician_profiles/{techId} {
      allow read, write: if true;
    }

    // Bookings & Real-time Dispatch
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    match /dispatch_requests/{requestId} {
      allow read, write: if true;
    }

    // Real-time chat messages per booking
    match /booking_chats/{bookingId}/messages/{messageId} {
      allow read, write: if true;
    }

    // Presence & live tracking stream
    match /presence/{uid} {
      allow read, write: if true;
    }

    // Notifications & Audit Logs
    match /notifications/{docId=**} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Fallback for admin & operational collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

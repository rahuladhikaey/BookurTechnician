rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' || 
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.admin == true
      );
    }

    // 1. Master Service Catalog & Banners (Public Read, Admin Write Only)
    match /service_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. User Profiles & Addresses (Private - Owner or Admin Only)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /customers/{custId} {
      allow read: if isOwner(custId) || isAdmin();
      allow write: if isOwner(custId) || isAdmin();
    }

    // 3. Technician Public Profiles (Read by Authenticated Users, Field-Guarded Write by Owner or Admin)
    match /technician_profiles/{techId} {
      allow read: if isAuthenticated() || isAdmin();
      allow create: if isAdmin() || (
        isOwner(techId) &&
        (!('verifiedByAdminUid' in request.resource.data)) &&
        (!('kycStatus' in request.resource.data) || request.resource.data.kycStatus in ['NOT_SUBMITTED', 'PENDING']) &&
        (!('skillVerificationStatus' in request.resource.data) || request.resource.data.skillVerificationStatus in ['PENDING'])
      );
      allow update: if isAdmin() || (
        isOwner(techId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'verifiedByAdminUid',
          'skillVerificationStatus',
          'isAdminApproved',
          'kycStatus',
          'accountStatus',
          'walletBalance',
          'rating',
          'totalRatingsCount',
          'totalJobsCompleted'
        ])
      );
      allow delete: if isAdmin();
    }

    // 3b. Technician Private KYC & Payout Vault (Strictly Owner or Admin Only — Never Public)
    match /technician_private/{techId} {
      allow read: if isOwner(techId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(techId) &&
        !request.resource.data.keys().hasAny([
          'verifiedAt',
          'verifiedByAdminUid'
        ]) &&
        (!('voterIdVerificationStatus' in request.resource.data) || request.resource.data.voterIdVerificationStatus in ['NOT_PROVIDED', 'PENDING']) &&
        (!('upiVerificationStatus' in request.resource.data) || request.resource.data.upiVerificationStatus in ['NOT_PROVIDED', 'PENDING'])
      );
      allow update: if isAdmin() || (
        isOwner(techId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'voterIdVerificationStatus',
          'aadhaarVerificationStatus',
          'upiVerificationStatus',
          'verifiedAt',
          'verifiedByAdminUid'
        ])
      );
      allow delete: if isAdmin();
    }

    // 4. Bookings (Backend-Authoritative Assignment & Financial Security)
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.customerId == request.auth.uid || 
        resource.data.technicianId == request.auth.uid || 
        isAdmin()
      );
      // Customers can create initial booking without assigning a technician
      allow create: if isAuthenticated() && 
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status in ['PENDING', 'SEARCHING', 'SUBMITTED', 'CONFIRMED'] &&
        (!('technicianId' in request.resource.data) || request.resource.data.technicianId == null || request.resource.data.technicianId == '');

      // Clients CANNOT alter authoritative assignment, pricing, status, OTP, or financial records
      allow update: if isAdmin() || (
        isAuthenticated() && (
          // Customer can cancel their own pending booking
          (resource.data.customerId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancellationReason', 'cancelledAt', 'updatedAt']) &&
           request.resource.data.status == 'CANCELLED') ||
          // Assigned technician can update transit location and live telemetry only (never status, OTP, assignment, or financials)
          (resource.data.technicianId == request.auth.uid &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'status', 'customerId', 'technicianId', 'totalAmount', 'grandTotal', 'price',
             'basePrice', 'discountPrice', 'paymentStatus', 'advancePaid',
             'technicianPayoutAmount', 'startOtp', 'endOtp', 'bookingCharge'
           ]))
        )
      );
      allow delete: if isAdmin();
    }

    // 4b. Sequential Dispatch Offers (Technicians Access Only Their Assigned Offers)
    match /dispatch_offers/{offerId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.technicianId == request.auth.uid ||
        resource.data.targetTechnicianUid == request.auth.uid ||
        isAdmin()
      );
      // Offers are created strictly by authoritative backend or admin
      allow create: if isAdmin();
      // Assigned technician can only directly REJECT an offer. ACCEPTANCE is strictly reserved for the trusted Cloud Functions transaction.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        (resource.data.technicianId == request.auth.uid || resource.data.targetTechnicianUid == request.auth.uid) &&
        resource.data.status in ['SENT', 'PENDING'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'responseReason', 'updatedAt']) &&
        request.resource.data.status == 'REJECTED'
      );
      allow delete: if isAdmin();
    }

    // 4e. Cryptographic Booking Secrets Vault (Admin SDK Only — Never exposed to any client)
    match /booking_secrets/{bookingId} {
      allow read, write: if false;
    }

    // 4f. Customer Private OTP Delivery Vault (Customer Owner Read Only — Never Technician)
    match /customer_otps/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // 4c. Dispatch Sessions & State Tracking (Server-Authoritative Only)
    match /dispatch_sessions/{sessionId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource == null ||
          resource.data.customerId == request.auth.uid ||
          resource.data.assignedTechnicianId == request.auth.uid
        )
      );
      allow write: if isAdmin();
    }

    // 4d. Booking Audit Timeline & Lifecycle Events (Server-Authoritative Only)
    match /booking_events/{eventId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.customerId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    match /dispatch_requests/{requestId} {
      allow read, write: if isAuthenticated() && (
        resource == null ||
        resource.data.technicianId == request.auth.uid || 
        isAdmin()
      );
    }

    // 5. Real-Time Chat per Booking
    match /booking_chats/{bookingId}/messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // 6. Presence & Live Tracking Streams
    match /presence/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) || isAdmin();
    }

    // 7. System Audit Logs & Dispatch Audit Logs (Admin Read Only, Write Denied for Direct Clients)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dispatch_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 8. Wallet & Withdrawals (Manual UPI Ledger)
    match /wallet/{techId} {
      allow read: if isOwner(techId) || isAdmin();
      allow write: if isAdmin(); // Clients cannot directly write or modify wallet balances
    }

    match /wallet_withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.technicianId == request.auth.uid ||
        isAdmin()
      );
      // Technicians can submit a withdrawal request strictly with status 'PENDING'
      allow create: if isAuthenticated() &&
        request.resource.data.technicianId == request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.amount > 0 &&
        request.resource.data.destinationUpi is string;
      // Only verified Admin can approve, reject, or mark withdrawal as PAID with bank UTR reference
      allow update: if isAdmin() &&
        request.resource.data.status in ['APPROVED', 'PAID', 'REJECTED'] &&
        (request.resource.data.status != 'PAID' || ('utrReference' in request.resource.data && request.resource.data.utrReference.size() >= 6));
      allow delete: if isAdmin();
    }

    // Fallback: Deny all other unclassified access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

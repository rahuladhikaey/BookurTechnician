# BookurTechnician Partner App - Production Upload Keystore Configuration
# Copy this file to 'key.properties' in this directory and populate with your production credentials.
# NEVER commit key.properties or the .jks/.keystore file to Git!

keyAlias=bookurtechnician_technician
keyPassword=YOUR_KEY_PASSWORD_HERE
storeFile=../keystores/release-technician.jks
storePassword=YOUR_STORE_PASSWORD_HERE

